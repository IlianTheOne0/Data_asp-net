@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <p>Username: @Model.UserName</p>
    <p>Birth Date: @Model.BirthDate</p>
    <p>User Age: @Model.UserAge</p>
    <p>Is Admin: @(Model.IsAdmin ? "Yes" : "No")</p>
    <p>Account Created On: @Model.CreationTime.ToString("d MMM yyyy H:m")</p>
</div>